---
import { Image } from 'astro:assets';

import placeholder from '@/assets/images/team/placeholder.jpg';

interface Props {
  /** Blobs key of the photo; the placeholder is shown without one. */
  photo: string | undefined;
  name: string;
  sizes: string;
  class?: string;
}

const { photo, name, sizes, class: className } = Astro.props;

// Portrait crop done by the Image CDN, same ratio as the card (898:1246), whatever the uploaded photo's shape.
const WIDTH = 652;
const HEIGHT = Math.round((WIDTH * placeholder.height) / placeholder.width);
---

{photo === undefined ? (
  <Image src={placeholder} alt="" class={className} />
) : (
  <Image
    src={`/media/${photo}`}
    width={WIDTH}
    height={HEIGHT}
    fit="cover"
    widths={[200, 326, 400, 652]}
    sizes={sizes}
    alt={`Photo de ${name}`}
    class={className}
  />
)}
