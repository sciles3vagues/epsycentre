---
import { Image } from 'astro:assets';

interface Props {
  /** Blobs key of the photo; without one, an empty block keeps the card's portrait shape. */
  photo: string | undefined;
  name: string;
  sizes: string;
  class?: string;
}

const { photo, name, sizes, class: className } = Astro.props;

// Portrait crop done by the Image CDN, same ratio as the card (898:1246), whatever the uploaded photo's shape.
const WIDTH = 652;
const HEIGHT = Math.round((WIDTH * 1246) / 898);
---

{photo === undefined ? (
  <div aria-hidden="true" class={`bg-noir/5 ${className ?? ''}`} />
) : (
  <Image
    src={`/media/${photo}`}
    width={WIDTH}
    height={HEIGHT}
    fit="cover"
    widths={[200, 326, 400, 652]}
    sizes={sizes}
    alt={`Photo de ${name}`}
    class={className}
  />
)}
