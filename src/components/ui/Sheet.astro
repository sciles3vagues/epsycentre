---
import { cn } from '@/lib/cn';

import styles from './Sheet.module.css';

import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'dialog'>, 'id' | 'class'> {
  id: string;
  label: string;
  closeAt?: string;
  class?: string;
}

const { id, label, closeAt, class: className, ...rest } = Astro.props;
---

<dialog
  id={id}
  aria-label={label}
  data-dialog
  data-dialog-close-at={closeAt}
  class={cn(
    styles.sheet,
    'fixed inset-0 m-0 h-dvh max-h-none w-full max-w-none overflow-y-auto p-0 backdrop:bg-transparent',
    className
  )}
  {...rest}
>
  <slot />
</dialog>

<script>
  import { initDialogs } from '@/scripts/dialog';

  initDialogs();
</script>
