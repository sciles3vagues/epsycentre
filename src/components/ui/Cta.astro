---
import { cn } from '@/lib/cn';

import type { Tone } from '@/types/tone';
import type { HTMLAttributes } from 'astro/types';

type Variant = 'outline' | 'solid';

interface BaseProps {
  tone?: Tone;
  variant?: Variant;
  class?: string;
}

type LinkProps = BaseProps & Omit<HTMLAttributes<'a'>, 'class'> & { href: string };
type ButtonProps = BaseProps & Omit<HTMLAttributes<'button'>, 'class'> & { href?: undefined };

export type Props = LinkProps | ButtonProps;

const { tone = 'clair', variant = 'outline', class: className, ...rest } = Astro.props;

const OUTLINE: Record<Tone, string> = {
  clair:
    'border-texte-clair text-texte-clair hover:bg-texte-clair hover:text-mandarine focus-visible:bg-texte-clair focus-visible:text-mandarine',
  secondary:
    'border-secondary text-secondary hover:bg-secondary hover:text-texte-clair focus-visible:bg-secondary focus-visible:text-texte-clair',
  tertiary:
    'border-tertiary text-tertiary hover:bg-tertiary hover:text-texte-clair focus-visible:bg-tertiary focus-visible:text-texte-clair',
  mandarine:
    'border-mandarine text-mandarine hover:bg-mandarine hover:text-texte-clair focus-visible:bg-mandarine focus-visible:text-texte-clair',
};

const SOLID: Record<Tone, string> = {
  clair:
    'border-texte-clair bg-texte-clair text-mandarine hover:bg-transparent hover:text-texte-clair focus-visible:bg-transparent focus-visible:text-texte-clair',
  secondary:
    'border-secondary bg-secondary text-texte-clair hover:bg-transparent hover:text-secondary focus-visible:bg-transparent focus-visible:text-secondary',
  tertiary:
    'border-tertiary bg-tertiary text-texte-clair hover:bg-transparent hover:text-tertiary focus-visible:bg-transparent focus-visible:text-tertiary',
  mandarine:
    'border-mandarine bg-mandarine text-texte-clair hover:bg-transparent hover:text-mandarine focus-visible:bg-transparent focus-visible:text-mandarine',
};

const classes = cn(
  'inline-flex min-w-[10.6875rem] items-center justify-center rounded-pill border-2 px-5.5 py-3 text-center font-heading text-bouton-mobile duration-300 ease-in-out focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-texte-clair focus-visible:outline-none motion-safe:transition md:min-w-[11.625rem] md:text-bouton',
  variant === 'outline' ? OUTLINE[tone] : SOLID[tone],
  className
);
---

{rest.href !== undefined ? (
  <a class={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type="button" class={classes} {...rest}>
    <slot />
  </button>
)}
