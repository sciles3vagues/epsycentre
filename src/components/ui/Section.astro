---
import Cta from '@/components/ui/Cta.astro';
import { SITE } from '@/config/site';
import { cn } from '@/lib/cn';

import type { Tone } from '@/types/tone';

type BackgroundColor = 'white' | 'fond' | 'gradient';

interface Props {
  id: string;
  title: string;
  tone?: Tone;
  backgroundColor?: BackgroundColor;
  hasCta?: boolean;
  class?: string;
}

const { id, title, tone, backgroundColor = 'white', hasCta = true, class: className } = Astro.props;

const isGradient = backgroundColor === 'gradient';
const resolvedTone: Tone = tone ?? (isGradient ? 'clair' : 'mandarine');
const titleId = `${id}-titre`;

const BACKGROUND: Record<BackgroundColor, string> = {
  white: 'bg-white',
  fond: 'bg-fond',
  gradient: 'bg-gradient-tcce',
};

const TITLE_COLOR: Record<Tone, string> = {
  clair: 'text-texte-clair',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
  mandarine: 'text-mandarine',
};
---

<section
  id={id}
  aria-labelledby={titleId}
  data-header-tone={isGradient ? 'clair' : 'mandarine'}
  class={cn('flex flex-col items-center gap-25 px-12.5 py-25', BACKGROUND[backgroundColor], className)}
>
  <h2 id={titleId} class={cn('text-center font-heading text-titre-mobile md:typo-titre', TITLE_COLOR[resolvedTone])}>
    {title}
  </h2>

  {Astro.slots.has('default') && (
    <div class="w-full">
      <slot />
    </div>
  )}

  {hasCta && (
    <Cta href={SITE.bookingUrl} tone={resolvedTone}>
      Prendre RDV
    </Cta>
  )}
</section>
