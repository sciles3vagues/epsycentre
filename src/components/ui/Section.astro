---
import Cta from '@/components/ui/Cta.astro';
import { SITE } from '@/config/site';
import { cn } from '@/lib/cn';

import type { Props as CtaProps } from '@/components/ui/Cta.astro';
import type { SectionBackground } from '@/types/background';
import type { Tone } from '@/types/tone';

interface Props {
  id: string;
  title: string;
  description?: string;
  tone?: Tone;
  backgroundColor?: SectionBackground;
  hasCta?: boolean;
  ctaVariant?: CtaProps['variant'];
  class?: string;
}

const {
  id,
  title,
  description,
  tone,
  backgroundColor = 'white',
  hasCta = true,
  ctaVariant = 'outline',
  class: className,
} = Astro.props;

const isGradient = backgroundColor === 'gradient';
const resolvedTone: Tone = tone ?? (isGradient ? 'clair' : 'mandarine');
const titleId = `${id}-titre`;

const BACKGROUND: Record<SectionBackground, string> = {
  white: 'bg-white',
  fond: 'bg-fond',
  gradient: 'bg-gradient-tcce',
};

const TITLE_COLOR: Record<Tone, string> = {
  clair: 'text-texte-clair',
  secondary: 'text-secondary',
  tertiary: 'text-tertiary',
  mandarine: 'text-mandarine',
};
---

<section
  id={id}
  aria-labelledby={titleId}
  data-section-bg={backgroundColor}
  class={cn(
    'flex flex-col items-center gap-12.5 px-5 py-12.5 md:gap-25 md:px-12.5 md:py-25',
    BACKGROUND[backgroundColor],
    className
  )}
>
  <div class="flex flex-col items-center gap-3 text-center md:gap-5.75">
    <h2 id={titleId} class={cn('font-heading text-titre-mobile uppercase md:typo-titre', TITLE_COLOR[resolvedTone])}>
      {title}
    </h2>
    {description !== undefined && (
      <p class={cn('max-w-222.5 text-corps-mobile md:text-corps', isGradient ? 'text-texte-clair' : 'text-noir')}>
        {description}
      </p>
    )}
  </div>

  {Astro.slots.has('default') && (
    <div class="w-full">
      <slot />
    </div>
  )}

  {hasCta && (
    <Cta href={SITE.bookingUrl} tone={resolvedTone} variant={ctaVariant}>
      Prendre RDV
    </Cta>
  )}
</section>
