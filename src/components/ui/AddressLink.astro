---
import { SITE } from '@/config/site';
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const { street, postalCode, city } = SITE.address;
const fullAddress = `${street}, ${postalCode} ${city}`;
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(fullAddress)}`;
---

<address class={cn('not-italic', className)}>
  <a href={mapsUrl} target="_blank" rel="noopener noreferrer" class="underline-offset-4 hover:underline">
    {fullAddress}
    <span class="sr-only"> (ouvre Google Maps dans un nouvel onglet)</span>
  </a>
</address>
