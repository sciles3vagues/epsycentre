---
import styles from './GroupPill.module.css';

interface Props {
  name: string;
  description: string;
}

const { name, description } = Astro.props;
---

<!-- md+: the pill floats over the row gap when expanded, so hovering never shifts the layout. -->
<div class="relative w-62.5 md:h-23.5 md:w-59.25">
  <details
    class={`${styles.pill} rounded-card border border-secondary bg-white md:absolute md:inset-x-0 md:top-0 md:hover:z-10 md:open:z-10`}
  >
    <summary class="flex cursor-pointer list-none items-center justify-center px-5 py-2.5 text-center font-sans text-nom-mobile text-secondary md:min-h-23 md:p-5 md:text-nom [&::-webkit-details-marker]:hidden">
      {name}
    </summary>
    <p class="px-5 pb-4 text-center text-petit text-secondary">{description}</p>
  </details>
</div>
