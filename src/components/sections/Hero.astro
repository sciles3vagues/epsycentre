---
import LogoSymbole from '@/assets/logo/logo-symbole.svg';
import Cta from '@/components/ui/Cta.astro';
import { SITE } from '@/config/site';
---

<section
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-dvh flex-col justify-end overflow-hidden bg-gradient-tcce px-5 py-10 md:p-12.5"
>
  <LogoSymbole
    aria-hidden="true"
    focusable="false"
    class="pointer-events-none absolute -right-7.75 bottom-14.5 -z-10 h-auto w-64.5 text-white/30 md:top-[29%] md:right-0 md:bottom-auto md:w-[clamp(16rem,37.3vw,33.5rem)] md:translate-x-1/2 md:text-white/50"
  />

  <h1 class="sr-only">{SITE.name}</h1>

  <div class="flex max-w-62.5 flex-col items-start gap-11.25 md:max-w-165.5">
    <h2 id="hero-title" class="font-heading text-titre-mobile text-texte-clair md:typo-titre">
      Nous sommes un centre de thérapie cognitive, comportementale et émotionnelle situé à Biarritz
    </h2>
    <!-- TODO: fix!! it will be probably be a modal with team selection to send an email-->
    <Cta href={SITE.bookingUrl}>Prendre RDV</Cta>
  </div>
</section>
