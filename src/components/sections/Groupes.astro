---
import { getCollection } from 'astro:content';

import GroupPill from '@/components/groupes/GroupPill.astro';
import Section from '@/components/ui/Section.astro';

const groupes = (await getCollection('groupes')).sort((a, b) => a.data.order - b.data.order);
---

<Section
  id="groupes"
  title="Les groupes"
  description="Nous proposons également des thérapies dans un cadre collectif."
  tone="secondary"
  ctaVariant="solid"
>
  <ul class="mx-auto flex max-w-279 flex-col items-center gap-5 md:flex-row md:flex-wrap md:items-start md:justify-center md:gap-20">
    {groupes.map(({ data }) => (
      <li>
        <GroupPill name={data.name} description={data.description} />
      </li>
    ))}
  </ul>
</Section>
