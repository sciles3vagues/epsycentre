---
import GroupPill from '@/components/groupes/GroupPill.astro';
import Section from '@/components/ui/Section.astro';

// TODO: replace the placeholder with each group's description.
const PLACEHOLDER = 'Texte thérapie de groupe à ajouter.';

const GROUPS = [
  'Trouble bipolaire',
  'Dépression',
  'Gestion des émotions',
  'TOC',
  'Affirmation de soi',
  'Anxiété sociale',
  'TDAH',
  'Insomnie',
];
---

<Section
  id="groupes"
  title="Les groupes"
  description="Nous proposons également des thérapies dans un cadre collectif."
  tone="secondary"
  ctaVariant="solid"
>
  <ul class="mx-auto flex max-w-279 flex-col items-center gap-5 md:flex-row md:flex-wrap md:items-start md:justify-center md:gap-20">
    {GROUPS.map(name => (
      <li>
        <GroupPill name={name} description={PLACEHOLDER} />
      </li>
    ))}
  </ul>
</Section>
