---
import { getCollection } from 'astro:content';

import MemberCard from '@/components/team/MemberCard.astro';
import MemberModal from '@/components/team/MemberModal.astro';
import Section from '@/components/ui/Section.astro';

const members = (await getCollection('team')).sort((a, b) => a.data.order - b.data.order);
const modalIdOf = (id: string): string => `membre-${id}`;
---

<Section id="equipe" title="Les membres de l’équipe" tone="tertiary" backgroundColor="fond" class="relative z-10">
  <ul class="grid grid-cols-2 gap-x-3 gap-y-9 md:flex md:flex-wrap md:justify-center">
    {members.map(member => (
      <li class="row-span-3 grid grid-rows-subgrid gap-y-0 md:block md:w-81.5">
        <MemberCard name={member.data.name} jobTitle={member.data.jobTitle} modalId={modalIdOf(member.id)} />
      </li>
    ))}
  </ul>

  {members.map(member => (
    <MemberModal member={member} modalId={modalIdOf(member.id)} />
  ))}
</Section>
