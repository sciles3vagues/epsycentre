---
import { cn } from '@/lib/cn';

/** The invisible aria-hidden bold copy reserves the bold width, so hovering never shifts neighbouring links. */
interface Props {
  href: string;
  label: string;
  class?: string;
}

const { href, label, class: className } = Astro.props;
---

<a href={href} class={cn('group/link grid font-heading text-bouton', className)}>
  <span class="col-start-1 row-start-1 group-hover/link:font-bold group-focus-visible/link:font-bold motion-safe:transition-[font-weight] motion-safe:duration-300 motion-safe:ease-in-out">
    {label}
  </span>
  <span aria-hidden="true" class="invisible col-start-1 row-start-1 font-bold">
    {label}
  </span>
</a>
