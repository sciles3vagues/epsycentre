---
import HeaderDesktop from '@/components/header/HeaderDesktop.astro';
import HeaderMobile from '@/components/header/HeaderMobile.astro';

// TODO: finish this and review when other sections ready
/** Children react to `data-sticky` / `data-tone` (set by src/scripts/header/) through `group-data-*` variants. */
---

<header
  data-site-header
  data-sticky="false"
  data-tone="clair"
  class="group/header absolute inset-x-0 top-0 z-50 text-texte-clair data-[sticky=true]:fixed data-[tone=mandarine]:text-mandarine motion-safe:transition-colors motion-safe:duration-300 motion-safe:data-[sticky=true]:animate-header-in"
>
  <HeaderDesktop />
  <HeaderMobile />
</header>

<script>
  import { initHeader } from '@/scripts/header/init-header';

  initHeader();
</script>
