---
import { Font } from 'astro:assets';

import Footer from '@/components/footer/Footer.astro';
import Header from '@/components/header/Header.astro';
import Seo from '@/components/Seo.astro';
import { SITE } from '@/config/site';

import '@/styles/global.css';

import type { Props as SeoProps } from '@/components/Seo.astro';

export type Props = SeoProps;

const props = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <!-- Preload only the above-the-fold weights: Manrope 700 (titles) and Inter 400 (body). -->
    <Font cssVariable="--font-manrope" preload={[{ weight: '700' }]} />
    <Font cssVariable="--font-inter" preload={[{ weight: '400' }]} />
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#contenu"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2"
    >
      Aller au contenu principal
    </a>
    <Header />
    <main id="contenu" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
